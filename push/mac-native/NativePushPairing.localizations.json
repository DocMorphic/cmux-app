  "androidPush.pair.instructions": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Connect this Mac in cmux on Android, then open Settings → Push Alerts and scan this code. Compare the address and key fingerprint before pairing."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Verbinde diesen Mac in cmux auf Android. Öffne dann Settings → Push Alerts und scanne diesen Code. Vergleiche vor dem Koppeln die Adresse und den Schlüsselfingerabdruck."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Connectez ce Mac dans cmux sur Android, puis ouvrez Settings → Push Alerts et scannez ce code. Comparez l’adresse et l’empreinte de la clé avant l’association."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "اتصل بهذا الـ Mac في cmux على Android، ثم افتح Settings → Push Alerts وامسح هذا الرمز. قارن العنوان وبصمة المفتاح قبل الإقران."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Conecta este Mac en cmux para Android, abre Settings → Push Alerts y escanea este código. Compara la dirección y la huella de la clave antes de vincular."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "在 Android 的 cmux 中連接這台 Mac，然後開啟 Settings → Push Alerts 並掃描此代碼。配對前請比對地址和金鑰指紋。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "在 Android 的 cmux 中连接这台 Mac，然后打开 Settings → Push Alerts 并扫描此代码。配对前请比对地址和密钥指纹。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "Android의 cmux에서 이 Mac을 연결한 다음 Settings → Push Alerts를 열고 이 코드를 스캔하세요. 페어링 전에 주소와 키 지문을 비교하세요."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "Android の cmux でこの Mac に接続し、Settings → Push Alerts を開いてこのコードをスキャンしてください。ペアリング前にアドレスと鍵のフィンガープリントを照合してください。"
        }
      }
    }
  },
