  "androidPush.pair.error": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Pairing is unavailable. Sign in on this Mac, enable phone notifications, and check the private helper setup. Then try again."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Koppeln ist nicht verfügbar. Melde dich auf diesem Mac an, aktiviere Telefonbenachrichtigungen und prüfe die Einrichtung des privaten Helfers. Versuche es dann erneut."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L’association est indisponible. Connectez-vous sur ce Mac, activez les notifications du téléphone et vérifiez la configuration de l’assistant privé. Réessayez ensuite."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "الإقران غير متاح. سجّل الدخول على هذا الـ Mac، وفعّل إشعارات الهاتف، وتحقق من إعداد المساعد الخاص. ثم حاول مرة أخرى."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "La vinculación no está disponible. Inicia sesión en este Mac, activa las notificaciones del teléfono y revisa la configuración del asistente privado. Luego inténtalo de nuevo."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "目前無法配對。請在這台 Mac 登入、啟用手機通知並檢查私人助手設定，然後重試。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "目前无法配对。请在这台 Mac 登录、启用手机通知并检查私密助手设置，然后重试。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "페어링할 수 없습니다. 이 Mac에서 로그인하고 휴대전화 알림을 활성화한 후 비공개 도우미 설정을 확인하세요. 그런 다음 다시 시도하세요."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "ペアリングを利用できません。この Mac にサインインし、スマートフォンの通知を有効にして、非公開ヘルパーの設定を確認してください。その後、再試行してください。"
        }
      }
    }
  },
