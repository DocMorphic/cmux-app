# Keep vendored source hashes and fixtures identical on Windows and macOS.
* text=auto eol=lf
*.bat text eol=crlf
# Preserve the upstream license files verbatim, including their whitespace.
app/src/main/assets/licenses/JSch*.txt -whitespace
# Preserve the hash-pinned extraction of GeckoView's bundled license page.
app/src/main/assets/licenses/GeckoView.txt -whitespace
app/src/main/assets/licenses/Rtf.txt -whitespace
# These original third-party bytes are hash-pinned, including in APK verification.
app/src/main/assets/rtf-viewer/*.bundle.js -text -whitespace
