      "resource": "cmux_cloud_intro_key_title",
      "translations": {
        "en": "A private key keeps it private",
        "ar": "مفتاح خاص يحمي الاتصال",
        "de": "Ein privater Schlüssel schützt den Zugang",
        "es": "Una clave privada protege el acceso",
        "fr": "Une clé privée protège l’accès",
        "ja": "秘密鍵でプライバシーを守る",
        "ko": "개인 키로 접근을 보호합니다",
        "zh-Hans": "私钥保护访问",
        "zh-Hant": "私密金鑰保護存取"
