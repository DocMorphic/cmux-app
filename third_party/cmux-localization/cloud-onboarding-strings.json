    {
      "key": "mobile.cloud.onboarding.workspace.title",
      "resource": "cmux_cloud_intro_workspace_title",
      "translations": {
        "en": "Your workspace lives in the Cloud",
        "ar": "مساحة عملك موجودة في السحابة",
        "de": "Dein Arbeitsbereich liegt in der Cloud",
        "es": "Tu espacio de trabajo está en Cloud",
        "fr": "Votre espace de travail est dans le Cloud",
        "ja": "ワークスペースはCloud上にあります",
        "ko": "작업 공간은 Cloud에 있습니다",
        "zh-Hans": "你的工作区位于 Cloud",
        "zh-Hant": "你的工作區位於 Cloud"
      }
    },
    {
      "key": "mobile.cloud.onboarding.workspace.message",
      "resource": "cmux_cloud_intro_workspace_message",
      "translations": {
        "en": "Workspaces keep their terminals, browsers, and coding agents running on a Cloud machine.",
        "ar": "تُبقي مساحات العمل الطرفيات والمتصفحات ووكلاء البرمجة قيد التشغيل على جهاز Cloud.",
        "de": "Arbeitsbereiche lassen ihre Terminals, Browser und Programmierassistenten auf einer Cloud-Maschine weiterlaufen.",
        "es": "Los espacios de trabajo mantienen sus terminales, navegadores y agentes de programación en una máquina Cloud.",
        "fr": "Vos espaces de travail gardent leurs terminaux, navigateurs et agents de programmation actifs sur une machine Cloud.",
        "ja": "ワークスペースでは、ターミナル、ブラウザ、コーディングエージェントがCloudマシン上で動き続けます。",
        "ko": "워크스페이스는 터미널, 브라우저, 코딩 에이전트를 Cloud 머신에서 계속 실행합니다.",
        "zh-Hans": "工作区会让终端、浏览器和编程代理继续在 Cloud 主机上运行。",
        "zh-Hant": "工作區會讓終端機、瀏覽器和程式設計代理持續在 Cloud 主機上執行。"
      }
    },
    {
      "key": "mobile.cloud.vpn.title",
