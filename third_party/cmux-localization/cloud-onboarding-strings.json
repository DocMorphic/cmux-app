    {
      "key": "mobile.cloud.onboarding.vpn.controlFooter",
      "resource": "cmux_cloud_intro_vpn_control_footer",
      "translations": {
        "en": "You can change this later in Cloud settings.",
        "ar": "يمكنك تغيير ذلك لاحقًا في إعدادات Cloud.",
        "de": "Du kannst dies später in den Cloud-Einstellungen ändern.",
        "es": "Puedes cambiarlo más tarde en los ajustes de Cloud.",
        "fr": "Vous pourrez modifier ce réglage plus tard dans les réglages Cloud.",
        "ja": "この設定は後でCloud設定から変更できます。",
        "ko": "나중에 Cloud 설정에서 변경할 수 있습니다.",
        "zh-Hans": "稍后可以在 Cloud 设置中更改。",
        "zh-Hant": "之後可以在 Cloud 設定中變更。"
      }
